{
  "name": "warzone-offline-server",
  "version": "0.1.0",
  "description": "Warzone Mobile Offline Server — pesquisa/preservação (M0 skeleton)",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "dev:bootstrap": "tsx src/bootstrap/cli.ts",
    "start": "node --loader ts-node/esm src/index.ts",
    "start:bootstrap": "node --loader ts-node/esm src/bootstrap/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --check \"src/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\""
  },
  "keywords": ["warzone", "preservation", "private-server", "demonware"],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "prettier": "^3.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.3.0"
  },
  "dependencies": {}
}
